# Copy to .env and adjust. All values below are the defaults.
APP_NAME="RASA ERP API"
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# SQLite for now. Switching to PostgreSQL later is just this line, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rasa_erp
DATABASE_URL=sqlite:///./rasa_erp.db

# Where uploaded PDFs / photos will be stored
UPLOAD_DIR=uploads
